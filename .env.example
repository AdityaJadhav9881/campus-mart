# CampusMart AI — environment template
# Copy to `.env` for local dev, or set these in Vercel → Settings → Environment Variables.
# Only VITE_* variables are exposed to the browser bundle.

# FastAPI + PostgreSQL backend base URL (no trailing slash).
# Local development:  http://127.0.0.1:8000
# Production:         https://campusmart-api.onrender.com
# If unset in production the site falls back to "Offline Demo Mode"
# (seed listings only — no live sync, no console-failing requests to localhost).
# The FastAPI server must allow this site's origin via CORS (allow_origins).
VITE_API_BASE_URL=https://campusmart-api.onrender.com

# Direct Android APK download URL used by the "Get CampusMart AI" modal.
# Use a site-root path (place the file in public/) or an absolute URL.
# The QR code on the download tab encodes the resolved absolute URL.
VITE_APK_DOWNLOAD_URL=/campusmart-ai.apk
